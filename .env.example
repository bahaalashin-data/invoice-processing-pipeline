# Copy this file to ".env" and fill in your real values.
# NEVER commit the real ".env" file to GitHub (it's already in .gitignore).

# --- Email (IMAP - reading the inbox) ---
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
EMAIL_ADDRESS=your_email@gmail.com
EMAIL_PASSWORD=your_app_password
IMAP_FOLDER=INBOX
IMAP_SUBJECT_FILTER=Invoices

# --- Email (SMTP - sending the reply) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# Only process emails from these addresses (comma-separated).
# Leave empty to allow any sender.
ALLOWED_SENDERS=

# Where the completion email + report goes.
# Leave empty to reply to whoever sent the invoice email.
REPORT_RECIPIENT_EMAIL=

# Extra recipients to CC on the completion email (comma-separated).
# Leave empty for no CC.
REPORT_CC_EMAILS=

# --- Paths ---
ATTACHMENTS_DIR=attachments
EXTRACTED_PDFS_DIR=extracted_pdfs
REPORTS_DIR=reports
LOGS_DIR=logs
DATABASE_PATH=database/invoices.db

# --- Behavior ---
# How often (seconds) `--watch` mode checks the inbox again.
POLL_INTERVAL_SECONDS=60

# How many times to retry a failed IMAP/SMTP connection.
EMAIL_RETRY_COUNT=3

# Attachment safety limits.
ALLOWED_ATTACHMENT_EXTENSIONS=.zip
MAX_ATTACHMENT_SIZE_MB=50

# --- Data quality ---
# quantity x unit_price vs total_amount is allowed to differ by this
# fraction (rounding in the source invoice) before the line is rejected.
AMOUNT_MISMATCH_TOLERANCE_PCT=0.01

# Reject a whole batch if it mixes invoices from more than one month.
REQUIRE_SAME_INVOICE_MONTH=true
